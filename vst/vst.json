{
  "name": "Shapey EQ",
  "vendor": "3DTHC",
  "uid": "ShEQ",
  "version": 1610,
  "so": "shapey_eq.so",
  "params": "params.json",
  "effect": true,
  "build": {
    "root": "..",
    "sources": [
      "src/engine.cpp"
    ],
    "cflags": [
      "-O2"
    ],
    "libs": [
      "-lm"
    ]
  },
  "layout": "layout.conf",
  "art": "html",
  "skin_post": "skin_post.py",
  "presets": "presets.json",
  "defines": {
    "VST3_REPLACES_VST2": 1,
    "HAS_DISPLAY_REV": 1,
    "DISPLAY_REV_NO_UPDATE": 1
  },
  "targets": ["armv7", "aarch64"]
}
